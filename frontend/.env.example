# Hisab Khata Mobile App Environment Configuration Template
# Copy this file to .env before starting Expo

# Backend API URL (do NOT put sensitive backend secrets or MongoDB credentials here)
# For physical devices or Expo Go on the same Wi-Fi, use your machine's LAN IP:
EXPO_PUBLIC_API_URL=http://192.168.0.107:5000

# Optional Google OAuth Client IDs for Expo App (matches backend configuration)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your_google_android_client_id.apps.googleusercontent.com
