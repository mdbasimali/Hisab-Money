# ==============================================================================
# Hisab Khata Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Node Environment: development, test, production
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your MongoDB Atlas cluster URI or local MongoDB URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hisab_khata?retryWrites=true&w=majority

# Development Mock User Override (Only used when NODE_ENV=development or test)
# In production, this is strictly disabled and rejected by security middleware.
DEV_MOCK_USER_ID=dev-user-1
DEV_MOCK_USER_EMAIL=ramesh.sharma@example.com
DEV_MOCK_USER_NAME=Ramesh Sharma
DEV_MOCK_BUSINESS_NAME=Sharma General Store

# Allowed Origins for CORS (comma-separated)
# Include Expo development server ports and devices
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082,http://localhost:19000,http://localhost:19006,exp://127.0.0.1:8081

# JWT Authentication Secrets
# Secure random secret key for signing backend session JWTs
JWT_SECRET=your_jwt_signing_secret_min_32_characters_here
JWT_EXPIRES_IN=7d

# Google OAuth Configuration
# Configure your OAuth 2.0 Client IDs from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID_WEB=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your_google_android_client_id.apps.googleusercontent.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

