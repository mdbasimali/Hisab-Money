# Root level .gitignore for Hisab Money Monorepo

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment files
.env
*.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Expo & Web builds
.expo/
frontend/.expo/
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts

# Native builds & keystores
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
